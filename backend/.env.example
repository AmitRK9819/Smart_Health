# ========================================================
# Smart Health Backend — Environment Variables
# Copy this file to .env before running the backend.
# ========================================================

# PostgreSQL connection string (psycopg2 format)
DATABASE_URL=postgresql://smarthealth:smarthealth_dev@localhost:5432/smarthealth_db

# Application metadata
APP_NAME=Healthcare Supply Chain API
APP_VERSION=0.1.0

# Debug mode (true/false) — controls log verbosity
DEBUG=true

# Comma-separated CORS allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174,http://127.0.0.1:3000,http://127.0.0.1:5173
