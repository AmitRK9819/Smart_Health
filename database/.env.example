# ========================================================
# Database Environment Variables
# Copy this file to .env before running docker-compose
# ========================================================

# PostgreSQL Core Settings
POSTGRES_USER=smarthealth
POSTGRES_PASSWORD=smarthealth_dev
POSTGRES_DB=smarthealth_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# URL String for Backend & DB Utilities (psycopg2)
DATABASE_URL=postgresql://smarthealth:smarthealth_dev@localhost:5432/smarthealth_db

# pgAdmin Login Details
PGADMIN_EMAIL=admin@smarthealth.local
PGADMIN_PASSWORD=admin
